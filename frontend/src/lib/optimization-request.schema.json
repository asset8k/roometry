{
  "$defs": {
    "AppearanceCorrection": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Id"
        },
        "field": {
          "enum": [
            "color",
            "wood",
            "metal",
            "linen",
            "inset",
            "rubber",
            "enamel",
            "floor_color",
            "wall_color",
            "floor_pattern"
          ],
          "title": "Field",
          "type": "string"
        },
        "previous_value": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Value"
        },
        "revised_value": {
          "maxLength": 16,
          "title": "Revised Value",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "source_image_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Source Image Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "field",
        "previous_value",
        "revised_value",
        "reason",
        "source_image_ids"
      ],
      "title": "AppearanceCorrection",
      "type": "object"
    },
    "EstimateCorrection": {
      "additionalProperties": false,
      "description": "Auditable revision of a photo size hypothesis, never a user measurement.",
      "properties": {
        "entity_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "width",
            "depth",
            "height",
            "width_m",
            "height_m",
            "sill_height_m"
          ],
          "title": "Field",
          "type": "string"
        },
        "previous_m": {
          "maximum": 30.0,
          "minimum": 0,
          "title": "Previous M",
          "type": "number"
        },
        "revised_m": {
          "maximum": 30.0,
          "minimum": 0,
          "title": "Revised M",
          "type": "number"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "source_image_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Source Image Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "field",
        "previous_m",
        "revised_m",
        "reason",
        "source_image_ids"
      ],
      "title": "EstimateCorrection",
      "type": "object"
    },
    "InputBudget": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "InputBudget",
      "type": "object"
    },
    "InterpretationCorrection": {
      "additionalProperties": false,
      "description": "Photo-backed revision of a classification/attachment hypothesis.",
      "properties": {
        "entity_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "type",
            "placement",
            "support_object_id"
          ],
          "title": "Field",
          "type": "string"
        },
        "previous_value": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Value"
        },
        "revised_value": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revised Value"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "source_image_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Source Image Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "field",
        "previous_value",
        "revised_value",
        "reason",
        "source_image_ids"
      ],
      "title": "InterpretationCorrection",
      "type": "object"
    },
    "MaterialColors": {
      "additionalProperties": false,
      "description": "Small, fixed palette of visible material roles; null keeps model defaults.",
      "properties": {
        "wood": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wood"
        },
        "metal": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metal"
        },
        "linen": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linen"
        },
        "inset": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inset"
        },
        "rubber": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubber"
        },
        "enamel": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enamel"
        }
      },
      "title": "MaterialColors",
      "type": "object"
    },
    "ObjectDimensions": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Depth",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "width",
        "depth",
        "height"
      ],
      "title": "ObjectDimensions",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "door",
            "window"
          ],
          "title": "Type",
          "type": "string"
        },
        "wall": {
          "enum": [
            "north",
            "south",
            "west",
            "east"
          ],
          "title": "Wall",
          "type": "string"
        },
        "offset_m": {
          "maximum": 30.0,
          "minimum": 0,
          "title": "Offset M",
          "type": "number"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width M",
          "type": "number"
        },
        "height_m": {
          "exclusiveMinimum": 0,
          "maximum": 10.0,
          "title": "Height M",
          "type": "number"
        },
        "sill_height_m": {
          "maximum": 10.0,
          "minimum": 0,
          "title": "Sill Height M",
          "type": "number"
        },
        "swing": {
          "enum": [
            "inward",
            "outward",
            "none",
            "unknown"
          ],
          "title": "Swing",
          "type": "string"
        },
        "hinge": {
          "anyOf": [
            {
              "enum": [
                "min_offset",
                "max_offset",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hinge"
        },
        "provenance": {
          "enum": [
            "photo_observed",
            "user_added"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "measurements_source": {
          "enum": [
            "user_confirmed",
            "estimated"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "wall",
        "offset_m",
        "width_m",
        "height_m",
        "sill_height_m",
        "swing",
        "hinge",
        "provenance",
        "measurements_source"
      ],
      "title": "Opening",
      "type": "object"
    },
    "OptimizationPreferences": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputBudget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "style": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style"
        },
        "constraints": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraints"
        }
      },
      "title": "OptimizationPreferences",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "World-space bottom center, in meters; room containment is checked later.",
      "properties": {
        "x": {
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100.0,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Position",
      "type": "object"
    },
    "RoomDimensions": {
      "additionalProperties": false,
      "properties": {
        "room_type": {
          "enum": [
            "bedroom",
            "living_room",
            "kitchen",
            "bathroom",
            "office",
            "dining_room",
            "entryway",
            "laundry_room",
            "other"
          ],
          "title": "Room Type",
          "type": "string"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width M",
          "type": "number"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Length M",
          "type": "number"
        },
        "height_m": {
          "exclusiveMinimum": 0,
          "maximum": 10.0,
          "title": "Height M",
          "type": "number"
        },
        "measurements_source": {
          "enum": [
            "user_confirmed",
            "estimated"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "required": [
        "room_type",
        "width_m",
        "length_m",
        "height_m",
        "measurements_source"
      ],
      "title": "RoomDimensions",
      "type": "object"
    },
    "RoomFinishes": {
      "additionalProperties": false,
      "properties": {
        "floor_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
