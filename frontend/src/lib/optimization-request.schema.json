        "wall_axis_bindings": {
          "items": {
            "$ref": "#/$defs/WallAxisBinding"
          },
          "maxItems": 4,
          "title": "Wall Axis Bindings",
          "type": "array"
        },
        "wall_mapping": {
          "items": {
            "$ref": "#/$defs/WallReference"
          },
          "maxItems": 4,
          "title": "Wall Mapping",
          "type": "array"
        },
        "estimate_corrections": {
          "items": {
            "$ref": "#/$defs/EstimateCorrection"
          },
          "maxItems": 200,
          "title": "Estimate Corrections",
          "type": "array"
        },
        "interpretation_corrections": {
          "items": {
            "$ref": "#/$defs/InterpretationCorrection"
          },
          "maxItems": 200,
          "title": "Interpretation Corrections",
          "type": "array"
        },
        "appearance_corrections": {
          "items": {
            "$ref": "#/$defs/AppearanceCorrection"
          },
          "maxItems": 200,
          "title": "Appearance Corrections",
          "type": "array"
        },
        "openings": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 32,
          "title": "Openings",
          "type": "array"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/SceneObject"
          },
          "maxItems": 200,
          "title": "Objects",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Assumptions",
          "type": "array"
        },
        "warnings": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "room",
        "openings",
        "objects",
        "assumptions",
        "warnings"
      ],
      "title": "RoomScene",
      "type": "object"
    },
