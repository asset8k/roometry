            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Pattern"
        }
      },
      "title": "RoomFinishes",
      "type": "object"
    },
    "RoomScene": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "room": {
          "$ref": "#/$defs/RoomDimensions"
        },
        "finishes": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoomFinishes"
            },
            {
              "type": "null"
            }
          ],
          "default": null
