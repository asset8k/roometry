{
  "$defs": {
    "AestheticComparison": {
      "additionalProperties": false,
      "properties": {
        "retained": {
          "$ref": "#/$defs/AestheticScores"
        },
        "candidate": {
          "$ref": "#/$defs/AestheticScores"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "explanation": {
          "maxLength": 320,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "retained",
        "candidate",
        "confidence",
        "explanation"
      ],
      "title": "AestheticComparison",
      "type": "object"
    },
    "AestheticScores": {
      "additionalProperties": false,
      "properties": {
        "color_harmony": {
          "maximum": 2,
          "minimum": 0,
          "title": "Color Harmony",
          "type": "integer"
        },
        "material_cohesion": {
          "maximum": 2,
          "minimum": 0,
          "title": "Material Cohesion",
          "type": "integer"
        },
        "visual_balance": {
          "maximum": 2,
          "minimum": 0,
          "title": "Visual Balance",
          "type": "integer"
        },
        "visual_order": {
          "maximum": 2,
          "minimum": 0,
          "title": "Visual Order",
          "type": "integer"
        },
        "lighting_composition": {
          "maximum": 2,
          "minimum": 0,
          "title": "Lighting Composition",
          "type": "integer"
        }
      },
      "required": [
        "color_harmony",
        "material_cohesion",
        "visual_balance",
        "visual_order",
        "lighting_composition"
      ],
      "title": "AestheticScores",
      "type": "object"
    },
    "AppearanceCorrection": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Entity Id"
        },
        "field": {
          "enum": [
            "color",
            "wood",
            "metal",
            "linen",
            "inset",
            "rubber",
            "enamel",
            "floor_color",
            "wall_color",
            "floor_pattern"
          ],
          "title": "Field",
          "type": "string"
        },
        "previous_value": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Value"
        },
        "revised_value": {
          "maxLength": 16,
          "title": "Revised Value",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "source_image_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Source Image Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "field",
        "previous_value",
        "revised_value",
        "reason",
        "source_image_ids"
      ],
      "title": "AppearanceCorrection",
      "type": "object"
    },
    "AssessmentCard": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "rated",
            "unassessed",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "source": {
          "enum": [
            "geometry",
            "photos"
          ],
          "title": "Source",
          "type": "string"
        },
        "explanation": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Entity Ids",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/ScoreMetric"
          },
          "maxItems": 12,
          "title": "Metrics",
          "type": "array"
        }
      },
      "required": [
        "status",
        "score",
        "confidence",
        "source",
        "explanation"
      ],
      "title": "AssessmentCard",
      "type": "object"
    },
    "CandidateReview": {
      "additionalProperties": false,
      "properties": {
        "preferred": {
          "enum": [
            "original",
            "candidate",
            "uncertain"
          ],
          "title": "Preferred",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "constraints_satisfied": {
          "title": "Constraints Satisfied",
          "type": "boolean"
        },
        "explanation": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "aesthetics": {
          "anyOf": [
            {
              "$ref": "#/$defs/AestheticComparison"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "preferred",
        "confidence",
        "constraints_satisfied",
        "explanation",
        "aesthetics"
      ],
      "title": "CandidateReview",
      "type": "object"
    },
    "EstimateCorrection": {
      "additionalProperties": false,
      "description": "Auditable revision of a photo size hypothesis, never a user measurement.",
      "properties": {
        "entity_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "width",
            "depth",
            "height",
            "width_m",
            "height_m",
            "sill_height_m"
          ],
          "title": "Field",
          "type": "string"
        },
        "previous_m": {
          "maximum": 30.0,
          "minimum": 0,
          "title": "Previous M",
          "type": "number"
        },
        "revised_m": {
          "maximum": 30.0,
          "minimum": 0,
          "title": "Revised M",
          "type": "number"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "source_image_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Source Image Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "field",
        "previous_m",
        "revised_m",
        "reason",
        "source_image_ids"
      ],
      "title": "EstimateCorrection",
      "type": "object"
    },
    "InputBudget": {
      "additionalProperties": false,
      "properties": {
        "amount": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Amount",
          "type": "number"
        },
        "currency": {
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "title": "InputBudget",
      "type": "object"
    },
    "InterpretationCorrection": {
      "additionalProperties": false,
      "description": "Photo-backed revision of a classification/attachment hypothesis.",
      "properties": {
        "entity_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "type",
            "placement",
            "support_object_id"
          ],
          "title": "Field",
          "type": "string"
        },
        "previous_value": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previous Value"
        },
        "revised_value": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Revised Value"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "source_image_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Source Image Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "field",
        "previous_value",
        "revised_value",
        "reason",
        "source_image_ids"
      ],
      "title": "InterpretationCorrection",
      "type": "object"
    },
    "MaterialColors": {
      "additionalProperties": false,
      "description": "Small, fixed palette of visible material roles; null keeps model defaults.",
      "properties": {
        "wood": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wood"
        },
        "metal": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metal"
        },
        "linen": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linen"
        },
        "inset": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inset"
        },
        "rubber": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubber"
        },
        "enamel": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enamel"
        }
      },
      "title": "MaterialColors",
      "type": "object"
    },
    "ObjectDimensions": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Depth",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "width",
        "depth",
        "height"
      ],
      "title": "ObjectDimensions",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "door",
            "window"
          ],
          "title": "Type",
          "type": "string"
        },
        "wall": {
          "enum": [
            "north",
            "south",
            "west",
            "east"
          ],
          "title": "Wall",
          "type": "string"
        },
        "offset_m": {
          "maximum": 30.0,
          "minimum": 0,
          "title": "Offset M",
          "type": "number"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width M",
          "type": "number"
        },
        "height_m": {
          "exclusiveMinimum": 0,
          "maximum": 10.0,
          "title": "Height M",
          "type": "number"
        },
        "sill_height_m": {
          "maximum": 10.0,
          "minimum": 0,
          "title": "Sill Height M",
          "type": "number"
        },
        "swing": {
          "enum": [
            "inward",
            "outward",
            "none",
            "unknown"
          ],
          "title": "Swing",
          "type": "string"
        },
        "hinge": {
          "anyOf": [
            {
              "enum": [
                "min_offset",
                "max_offset",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hinge"
        },
        "provenance": {
          "enum": [
            "photo_observed",
            "user_added"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "measurements_source": {
          "enum": [
            "user_confirmed",
            "estimated"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "wall",
        "offset_m",
        "width_m",
        "height_m",
        "sill_height_m",
        "swing",
        "hinge",
        "provenance",
        "measurements_source"
      ],
      "title": "Opening",
      "type": "object"
    },
    "OptimizationAttempt": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "maximum": 5,
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "accepted",
            "rejected",
            "no_gain"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "before_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Score"
        },
        "after_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Score"
        },
        "changed_object_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Changed Object Ids",
          "type": "array"
        },
        "issues": {
          "items": {
            "maxLength": 500,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Issues",
          "type": "array"
        },
        "summary": {
          "maxLength": 500,
          "title": "Summary",
          "type": "string"
        },
        "review": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "number",
        "outcome",
        "before_score",
        "after_score",
        "changed_object_ids",
        "issues",
        "summary",
        "review"
      ],
      "title": "OptimizationAttempt",
      "type": "object"
    },
    "OptimizationPreferences": {
      "additionalProperties": false,
      "properties": {
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/InputBudget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "style": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Style"
        },
        "constraints": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Constraints"
        }
      },
      "required": [
        "budget",
        "style",
        "constraints"
      ],
      "title": "OptimizationPreferences",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "World-space bottom center, in meters; room containment is checked later.",
      "properties": {
        "x": {
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100.0,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Position",
      "type": "object"
    },
    "RoomAssessment": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "default": "room-assessment-v2",
          "enum": [
            "room-assessment-v1",
            "room-assessment-v2"
          ],
          "title": "Policy Version",
          "type": "string"
        },
        "scene_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Scene Hash",
          "type": "string"
        },
        "openness": {
          "$ref": "#/$defs/AssessmentCard"
        },
        "storage": {
          "$ref": "#/$defs/AssessmentCard"
        },
        "workspace": {
          "$ref": "#/$defs/AssessmentCard"
        },
        "aesthetics": {
          "$ref": "#/$defs/AssessmentCard"
        },
        "recommended": {
          "anyOf": [
            {
              "enum": [
                "openness",
                "storage",
                "workspace",
                "aesthetics"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recommended"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "scene_hash",
        "openness",
        "storage",
        "workspace",
        "aesthetics",
        "recommended",
        "notes"
      ],
      "title": "RoomAssessment",
      "type": "object"
    },
    "RoomDimensions": {
      "additionalProperties": false,
      "properties": {
        "room_type": {
          "enum": [
            "bedroom",
            "living_room",
            "kitchen",
            "bathroom",
            "office",
            "dining_room",
            "entryway",
            "laundry_room",
            "other"
          ],
          "title": "Room Type",
          "type": "string"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width M",
          "type": "number"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Length M",
          "type": "number"
        },
        "height_m": {
          "exclusiveMinimum": 0,
          "maximum": 10.0,
          "title": "Height M",
          "type": "number"
        },
        "measurements_source": {
          "enum": [
            "user_confirmed",
            "estimated"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "required": [
        "room_type",
        "width_m",
        "length_m",
        "height_m",
        "measurements_source"
      ],
      "title": "RoomDimensions",
      "type": "object"
    },
    "RoomFinishes": {
      "additionalProperties": false,
      "properties": {
        "floor_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Color"
        },
        "wall_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Color"
        },
        "floor_pattern": {
          "anyOf": [
            {
              "enum": [
                "wood",
                "tile",
                "plain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Pattern"
        }
      },
      "title": "RoomFinishes",
      "type": "object"
    },
    "RoomScene": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "room": {
          "$ref": "#/$defs/RoomDimensions"
        },
        "finishes": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoomFinishes"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "wall_axis_bindings": {
          "items": {
            "$ref": "#/$defs/WallAxisBinding"
          },
          "maxItems": 4,
          "title": "Wall Axis Bindings",
          "type": "array"
        },
        "wall_mapping": {
          "items": {
            "$ref": "#/$defs/WallReference"
          },
          "maxItems": 4,
          "title": "Wall Mapping",
          "type": "array"
        },
        "estimate_corrections": {
          "items": {
            "$ref": "#/$defs/EstimateCorrection"
          },
          "maxItems": 200,
          "title": "Estimate Corrections",
          "type": "array"
        },
        "interpretation_corrections": {
          "items": {
            "$ref": "#/$defs/InterpretationCorrection"
          },
          "maxItems": 200,
          "title": "Interpretation Corrections",
          "type": "array"
        },
        "appearance_corrections": {
          "items": {
