{
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "kind": {
      "enum": [
        "reconstruction",
        "optimization"
      ],
      "title": "Kind",
      "type": "string"
    },
    "stage": {
      "enum": [
        "starting",
        "planning",
        "analyzing",
        "clarifying",
        "constructing",
        "checking",
        "reviewing",
        "assessing",
        "prepared",
        "proposing",
        "cancelling",
        "finished",
        "expired"
      ],
      "title": "Stage",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "awaiting_answer",
        "completed",
        "partial",
        "incomplete",
        "budget_exhausted",
        "cancelled",
        "expired",
        "failed",
        "prepared",
        "no_improvement"
      ],
      "title": "Status",
      "type": "string"
    },
    "step": {
      "maximum": 1000,
      "minimum": 0,
      "title": "Step",
      "type": "integer"
    },
    "candidate": {
      "anyOf": [
        {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Candidate"
    },
    "closed": {
      "title": "Closed",
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "run_id",
    "sequence",
    "kind",
    "stage",
    "status",
    "step",
    "candidate",
    "closed"
  ],
  "title": "ProgressEvent",
  "type": "object"
}
