{
  "$defs": {
    "InputDimensions": {
      "additionalProperties": false,
      "description": "Partial user measurements; omission never manufactures scene dimensions.",
      "properties": {
        "width_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 30.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width M"
        },
        "length_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 30.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length M"
        },
        "height_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height M"
        },
        "measurements_source": {
          "default": "estimated",
          "enum": [
            "estimated",
            "user_confirmed"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "title": "InputDimensions",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "analysis_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Analysis Id",
      "type": "string"
    },
    "dimensions": {
      "anyOf": [
        {
          "$ref": "#/$defs/InputDimensions"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "allow_estimated_dimensions": {
      "default": false,
      "title": "Allow Estimated Dimensions",
      "type": "boolean"
    }
  },
  "required": [
    "analysis_id"
  ],
  "title": "SceneProposalRequest",
  "type": "object"
}
