            "water_heater",
            "drying_rack"
          ],
          "title": "Type",
          "type": "string"
        },
        "asset_id": {
          "enum": [
            "bed_standard_01",
            "sofa_standard_01",
            "armchair_standard_01",
            "chair_standard_01",
            "stool_standard_01",
            "bench_standard_01",
