          "maxLength": 96,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Asset Id",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/Position"
        },
        "rotation_y_rad": {
          "title": "Rotation Y Rad",
          "type": "number"
        },
        "dimensions_m": {
          "$ref": "#/$defs/ObjectDimensions"
        },
        "color": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Color",
          "type": "string"
        },
        "placement": {
          "enum": [
            "floor",
            "surface",
            "wall",
            "ceiling"
          ],
          "title": "Placement",
          "type": "string"
        },
        "support_object_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Support Object Id"
        },
        "support_surface_id": {
          "anyOf": [
            {
              "maxLength": 96,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Surface Id"
        },
        "wall": {
          "anyOf": [
            {
              "enum": [
                "north",
                "south",
                "west",
                "east"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Wall"
        },
        "opening_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Opening Id"
        },
        "fixed": {
          "title": "Fixed",
          "type": "boolean"
        },
        "locked": {
          "title": "Locked",
          "type": "boolean"
        },
        "provenance": {
          "enum": [
            "photo_observed",
            "user_added",
            "agent_added"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "measurements_source": {
          "enum": [
            "user_confirmed",
            "catalog",
            "estimated"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "asset_id",
        "position",
        "rotation_y_rad",
        "dimensions_m",
        "color",
        "placement",
        "support_object_id",
        "wall",
        "opening_id",
        "fixed",
        "locked",
        "provenance",
        "measurements_source"
      ],
      "title": "SceneObject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "On rejection `scene` is the unmodified supplied base, not a saved revision.\n\nIf the base already fails geometry, it is returned for inspection and no edit\nis attempted. Geometry reports cover components-v1 only, not full acceptance.",
  "properties": {
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "scene": {
      "$ref": "#/$defs/RoomScene"
    },
    "changed_object_ids": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z][a-z0-9_]*$",
        "type": "string"
      },
      "title": "Changed Object Ids",
      "type": "array"
    },
    "edit_errors": {
      "items": {
        "$ref": "#/$defs/EditIssue"
      },
      "title": "Edit Errors",
      "type": "array"
    },
    "base_validation": {
      "$ref": "#/$defs/GeometryReport"
    },
    "candidate_validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeometryReport"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "accepted",
    "scene",
    "changed_object_ids",
    "edit_errors",
    "base_validation",
    "candidate_validation"
  ],
  "title": "PreviewEditResponse",
  "type": "object"
}
