{
  "$defs": {
    "EditIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "object_not_found",
            "object_locked",
            "object_fixed",
            "unsupported_placement",
            "protected_children",
            "candidate_schema",
            "invalid_base_geometry"
          ],
          "title": "Code",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "entity_ids",
        "message"
      ],
      "title": "EditIssue",
      "type": "object"
    },
    "GeometryIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "object_outside_room",
            "object_overlap",
            "rug_overlap",
            "surface_support",
            "wall_attachment",
            "ceiling_attachment",
            "opening_outside_wall",
            "wall_opening_overlap",
            "baseline_scope"
          ],
          "title": "Code",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "entity_ids",
        "message"
      ],
      "title": "GeometryIssue",
      "type": "object"
    },
    "GeometryReport": {
      "additionalProperties": false,
      "description": "`valid` means catalog component checks passed, not full scene acceptance.",
      "properties": {
        "policy_version": {
          "const": "components-v1",
          "default": "components-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "tolerance_m": {
          "default": 1e-06,
          "title": "Tolerance M",
          "type": "number"
        },
        "rotation_tolerance_rad": {
          "default": 1e-06,
          "title": "Rotation Tolerance Rad",
          "type": "number"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/GeometryIssue"
          },
          "title": "Errors",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/GeometryIssue"
          },
          "title": "Warnings",
          "type": "array"
        },
        "valid": {
          "readOnly": true,
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "errors",
        "warnings",
        "valid"
      ],
      "title": "GeometryReport",
      "type": "object"
    },
    "ObjectDimensions": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Depth",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "width",
        "depth",
        "height"
      ],
      "title": "ObjectDimensions",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "door",
            "window"
          ],
          "title": "Type",
          "type": "string"
        },
        "wall": {
          "enum": [
            "north",
            "south",
            "west",
            "east"
          ],
          "title": "Wall",
          "type": "string"
        },
        "offset_m": {
          "maximum": 30.0,
          "minimum": 0,
          "title": "Offset M",
          "type": "number"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width M",
          "type": "number"
        },
        "height_m": {
          "exclusiveMinimum": 0,
          "maximum": 10.0,
          "title": "Height M",
          "type": "number"
        },
        "sill_height_m": {
          "maximum": 10.0,
          "minimum": 0,
          "title": "Sill Height M",
          "type": "number"
        },
        "swing": {
          "enum": [
            "inward",
            "outward",
            "none",
            "unknown"
          ],
          "title": "Swing",
          "type": "string"
        },
        "hinge": {
          "anyOf": [
            {
              "enum": [
                "min_offset",
                "max_offset",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hinge"
        },
        "provenance": {
          "enum": [
            "photo_observed",
            "user_added"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "measurements_source": {
          "enum": [
            "user_confirmed",
            "estimated"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "wall",
        "offset_m",
        "width_m",
        "height_m",
        "sill_height_m",
        "swing",
        "hinge",
        "provenance",
        "measurements_source"
      ],
      "title": "Opening",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "World-space bottom center, in meters; room containment is checked later.",
      "properties": {
        "x": {
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100.0,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Position",
      "type": "object"
    },
    "RoomDimensions": {
      "additionalProperties": false,
      "properties": {
        "room_type": {
          "enum": [
            "bedroom",
            "living_room",
            "kitchen",
            "bathroom",
            "office",
            "dining_room",
            "entryway",
            "laundry_room",
            "other"
          ],
          "title": "Room Type",
          "type": "string"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width M",
          "type": "number"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Length M",
          "type": "number"
        },
        "height_m": {
          "exclusiveMinimum": 0,
          "maximum": 10.0,
          "title": "Height M",
          "type": "number"
        },
        "measurements_source": {
          "enum": [
            "user_confirmed",
            "estimated"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "required": [
        "room_type",
        "width_m",
        "length_m",
        "height_m",
        "measurements_source"
      ],
      "title": "RoomDimensions",
      "type": "object"
    },
    "RoomScene": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "room": {
          "$ref": "#/$defs/RoomDimensions"
        },
        "openings": {
          "items": {
            "$ref": "#/$defs/Opening"
          },
          "maxItems": 32,
          "title": "Openings",
          "type": "array"
        },
        "objects": {
          "items": {
            "$ref": "#/$defs/SceneObject"
          },
          "maxItems": 200,
          "title": "Objects",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Assumptions",
          "type": "array"
        },
        "warnings": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 50,
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "room",
        "openings",
        "objects",
        "assumptions",
        "warnings"
      ],
      "title": "RoomScene",
      "type": "object"
    },
    "SceneObject": {
