{
  "$defs": {
    "DoorCheck": {
      "additionalProperties": false,
      "properties": {
        "door_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Door Id",
          "type": "string"
        },
        "access_status": {
          "enum": [
            "clear",
            "blocked",
            "unassessed"
          ],
          "title": "Access Status",
          "type": "string"
        },
        "swing_status": {
          "enum": [
            "clear",
            "blocked",
            "unknown",
            "not_applicable",
            "outside_room",
            "unassessed"
          ],
          "title": "Swing Status",
          "type": "string"
        },
        "access_object_ids": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Access Object Ids",
          "type": "array"
        },
        "swing_object_ids": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Swing Object Ids",
          "type": "array"
        }
      },
      "required": [
        "door_id",
        "access_status",
        "swing_status"
      ],
      "title": "DoorCheck",
      "type": "object"
    },
    "DoorClearanceIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "door_access_blocked",
            "door_swing_blocked",
            "door_swing_unknown",
            "door_swing_outside_room",
            "door_clearance_unassessed"
          ],
          "title": "Code",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "entity_ids",
        "message"
      ],
      "title": "DoorClearanceIssue",
      "type": "object"
    },
    "DoorClearancePolicy": {
      "additionalProperties": false,
      "description": "MVP heuristics in meters; callers can supply a different bounded policy.",
      "properties": {
        "access_depth_m": {
          "default": 0.8,
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Access Depth M",
          "type": "number"
        },
        "floor_gap_m": {
          "default": 0.02,
          "maximum": 0.1,
          "minimum": 0,
          "title": "Floor Gap M",
          "type": "number"
        }
      },
      "title": "DoorClearancePolicy",
      "type": "object"
    },
    "DoorClearanceReport": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "const": "door-clearance-v1",
          "default": "door-clearance-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "policy": {
          "$ref": "#/$defs/DoorClearancePolicy"
        },
        "doors": {
          "items": {
            "$ref": "#/$defs/DoorCheck"
          },
          "title": "Doors",
          "type": "array"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/DoorClearanceIssue"
          },
          "title": "Issues",
          "type": "array"
        }
      },
      "required": [
        "policy",
        "doors",
        "issues"
      ],
      "title": "DoorClearanceReport",
      "type": "object"
    },
    "EntranceRoute": {
      "additionalProperties": false,
      "properties": {
        "door_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Door Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "clear",
            "narrow",
            "blocked",
            "unassessed"
          ],
          "title": "Status",
          "type": "string"
        },
        "main_region_reachable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Main Region Reachable"
        },
        "reachable_door_ids": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Reachable Door Ids",
          "type": "array"
        },
        "unreachable_door_ids": {
          "default": [],
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Unreachable Door Ids",
          "type": "array"
        }
      },
      "required": [
        "door_id",
        "status",
        "main_region_reachable"
      ],
      "title": "EntranceRoute",
      "type": "object"
    },
    "EstimateCorrection": {
      "additionalProperties": false,
      "description": "Auditable revision of a photo size hypothesis, never a user measurement.",
      "properties": {
        "entity_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Entity Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "width",
            "depth",
            "height",
            "width_m",
            "height_m",
            "sill_height_m"
          ],
          "title": "Field",
          "type": "string"
        },
        "previous_m": {
          "maximum": 30.0,
          "minimum": 0,
          "title": "Previous M",
          "type": "number"
        },
        "revised_m": {
          "maximum": 30.0,
          "minimum": 0,
          "title": "Revised M",
          "type": "number"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "source_image_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Source Image Ids",
          "type": "array"
        }
      },
      "required": [
        "entity_id",
        "field",
        "previous_m",
        "revised_m",
        "reason",
        "source_image_ids"
      ],
      "title": "EstimateCorrection",
      "type": "object"
    },
    "FidelityCheck": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "coverage",
            "facing",
            "wall",
            "adjacency",
            "support",
            "proportion",
            "color"
          ],
          "title": "Kind",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "entity_ids",
        "passed",
        "required",
        "message"
      ],
      "title": "FidelityCheck",
      "type": "object"
    },
    "FidelityReport": {
      "additionalProperties": false,
      "properties": {
        "policy_version": {
          "const": "reconstruction_v1",
          "default": "reconstruction_v1",
          "title": "Policy Version",
          "type": "string"
        },
        "major_object_coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Major Object Coverage",
          "type": "number"
        },
        "relationship_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Relationship Score"
        },
        "proportion_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Proportion Score"
        },
        "color_score": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Color Score"
        },
        "recognizable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Recognizable"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/FidelityCheck"
          },
          "maxItems": 4000,
          "title": "Checks",
          "type": "array"
        },
        "unassessed": {
          "items": {
            "type": "string"
          },
          "title": "Unassessed",
          "type": "array"
        }
      },
      "required": [
        "major_object_coverage",
        "relationship_score",
        "proportion_score",
        "color_score",
        "recognizable",
        "checks",
        "unassessed"
      ],
      "title": "FidelityReport",
      "type": "object"
    },
    "GeometryIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "enum": [
                "object_outside_room",
                "object_overlap",
                "rug_overlap",
                "surface_support",
                "wall_attachment",
                "ceiling_attachment",
                "opening_outside_wall",
                "wall_opening_overlap",
                "baseline_scope"
              ],
              "type": "string"
            },
            {
              "enum": [
                "door_access_blocked",
                "door_swing_blocked",
                "door_swing_unknown",
                "door_swing_outside_room",
                "door_clearance_unassessed"
              ],
              "type": "string"
            },
            {
              "enum": [
                "entrance_route_blocked",
                "entrances_disconnected",
                "walking_space_disconnected",
                "narrow_passage",
                "walking_space_unassessed"
              ],
              "type": "string"
            }
          ],
          "title": "Code"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "entity_ids",
        "message"
      ],
      "title": "GeometryIssue",
      "type": "object"
    },
    "GeometryReport": {
      "additionalProperties": false,
      "description": "`valid` covers component errors; door and walking findings stay advisory.",
      "properties": {
        "policy_version": {
          "const": "components-v1",
          "default": "components-v1",
          "title": "Policy Version",
          "type": "string"
        },
        "tolerance_m": {
          "default": 1e-06,
          "title": "Tolerance M",
          "type": "number"
        },
        "rotation_tolerance_rad": {
          "default": 1e-06,
          "title": "Rotation Tolerance Rad",
          "type": "number"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/GeometryIssue"
          },
          "title": "Errors",
          "type": "array"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/GeometryIssue"
          },
          "title": "Warnings",
          "type": "array"
        },
        "door_clearance": {
          "anyOf": [
            {
              "$ref": "#/$defs/DoorClearanceReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "walking_space": {
          "anyOf": [
            {
              "$ref": "#/$defs/WalkingReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "valid": {
          "readOnly": true,
          "title": "Valid",
          "type": "boolean"
        }
      },
      "required": [
        "errors",
        "warnings",
        "valid"
      ],
      "title": "GeometryReport",
      "type": "object"
    },
    "InputDimensions": {
      "additionalProperties": false,
      "description": "Partial user measurements; omission never manufactures scene dimensions.",
      "properties": {
        "width_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 30.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width M"
        },
        "length_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 30.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Length M"
        },
        "height_m": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 10.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height M"
        },
        "measurements_source": {
          "default": "estimated",
          "enum": [
            "estimated",
            "user_confirmed"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "title": "InputDimensions",
      "type": "object"
    },
    "MaterialColors": {
      "additionalProperties": false,
      "description": "Small, fixed palette of visible material roles; null keeps model defaults.",
      "properties": {
        "wood": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wood"
        },
        "metal": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metal"
        },
        "linen": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linen"
        },
        "inset": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inset"
        },
        "rubber": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rubber"
        },
        "enamel": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enamel"
        }
      },
      "title": "MaterialColors",
      "type": "object"
    },
    "ObjectDimensions": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width",
          "type": "number"
        },
        "depth": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Depth",
          "type": "number"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Height",
          "type": "number"
        }
      },
      "required": [
        "width",
        "depth",
        "height"
      ],
      "title": "ObjectDimensions",
      "type": "object"
    },
    "Opening": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "door",
            "window"
          ],
          "title": "Type",
          "type": "string"
        },
        "wall": {
          "enum": [
            "north",
            "south",
            "west",
            "east"
          ],
          "title": "Wall",
          "type": "string"
        },
        "offset_m": {
          "maximum": 30.0,
          "minimum": 0,
          "title": "Offset M",
          "type": "number"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width M",
          "type": "number"
        },
        "height_m": {
          "exclusiveMinimum": 0,
          "maximum": 10.0,
          "title": "Height M",
          "type": "number"
        },
        "sill_height_m": {
          "maximum": 10.0,
          "minimum": 0,
          "title": "Sill Height M",
          "type": "number"
        },
        "swing": {
          "enum": [
            "inward",
            "outward",
            "none",
            "unknown"
          ],
          "title": "Swing",
          "type": "string"
        },
        "hinge": {
          "anyOf": [
            {
              "enum": [
                "min_offset",
                "max_offset",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Hinge"
        },
        "provenance": {
          "enum": [
            "photo_observed",
            "user_added"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "measurements_source": {
          "enum": [
            "user_confirmed",
            "estimated"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "wall",
        "offset_m",
        "width_m",
        "height_m",
        "sill_height_m",
        "swing",
        "hinge",
        "provenance",
        "measurements_source"
      ],
      "title": "Opening",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "World-space bottom center, in meters; room containment is checked later.",
      "properties": {
        "x": {
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "X",
          "type": "number"
        },
        "y": {
          "maximum": 100.0,
          "minimum": 0,
          "title": "Y",
          "type": "number"
        },
        "z": {
          "maximum": 100.0,
          "minimum": -100.0,
          "title": "Z",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "z"
      ],
      "title": "Position",
      "type": "object"
    },
    "ProposalIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "unsupported_room_shape",
            "unknown_object",
            "unsupported_placement",
            "asset_mismatch",
            "insufficient_evidence",
            "draft_schema",
            "identity_mismatch",
            "wall_mapping",
            "placement_mismatch",
            "dimension_mismatch",
            "support_mismatch",
            "scene_schema",
            "geometry",
            "proposal_limit_reached",
            "dependency_unresolved",
            "repair_failed",
            "fidelity"
          ],
          "title": "Code",
          "type": "string"
        },
        "entity_ids": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "maxItems": 200,
          "title": "Entity Ids",
          "type": "array"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "entity_ids",
        "message"
      ],
      "title": "ProposalIssue",
      "type": "object"
    },
    "RoomDimensions": {
      "additionalProperties": false,
      "properties": {
        "room_type": {
          "enum": [
            "bedroom",
            "living_room",
            "kitchen",
            "bathroom",
            "office",
            "dining_room",
            "entryway",
            "laundry_room",
            "other"
          ],
          "title": "Room Type",
          "type": "string"
        },
        "width_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Width M",
          "type": "number"
        },
        "length_m": {
          "exclusiveMinimum": 0,
          "maximum": 30.0,
          "title": "Length M",
          "type": "number"
        },
        "height_m": {
          "exclusiveMinimum": 0,
          "maximum": 10.0,
          "title": "Height M",
          "type": "number"
        },
        "measurements_source": {
          "enum": [
            "user_confirmed",
            "estimated"
          ],
          "title": "Measurements Source",
          "type": "string"
        }
      },
      "required": [
        "room_type",
        "width_m",
        "length_m",
        "height_m",
        "measurements_source"
      ],
      "title": "RoomDimensions",
      "type": "object"
    },
    "RoomFinishes": {
      "additionalProperties": false,
      "properties": {
        "floor_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Color"
        },
        "wall_color": {
          "anyOf": [
            {
              "pattern": "^#[0-9A-Fa-f]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wall Color"
        },
        "floor_pattern": {
          "anyOf": [
            {
              "enum": [
                "wood",
                "tile",
                "plain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Floor Pattern"
        }
      },
      "title": "RoomFinishes",
      "type": "object"
    },
    "RoomScene": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "room": {
          "$ref": "#/$defs/RoomDimensions"
        },
        "finishes": {
          "anyOf": [
            {
              "$ref": "#/$defs/RoomFinishes"
            },
