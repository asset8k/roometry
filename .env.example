# Backend settings. Copy this file to .env in the repo root.
APP_ENVIRONMENT=development
# JSON array; list only the frontend origins you intend to allow.
# Vite's local /api proxy works without cross-origin browser requests.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Private temporary uploads. Local storage supports a single worker only.
MAX_IMAGES_PER_REQUEST=10
UPLOAD_MAX_FILE_BYTES=8388608
UPLOAD_MAX_TOTAL_FILE_BYTES=83886080
UPLOAD_MAX_BODY_BYTES=85983232
UPLOAD_MIN_EDGE_PX=256
UPLOAD_MAX_EDGE_PX=10000
UPLOAD_MAX_PIXELS=40000000
UPLOAD_PREPARED_MAX_EDGE_PX=2048
UPLOAD_PREPARED_MAX_BYTES=4194304
UPLOAD_TTL_SECONDS=3600
UPLOAD_STORAGE_DIR=uploads/room-inputs
UPLOAD_CLEANUP_INTERVAL_SECONDS=60

# Explicit opt-in: generation runs and the analysis API can send owned photos to OpenAI.
# No API call is made by uploading or starting the app. Never commit your key.
ANALYSIS_ENABLED=false
OPENAI_API_KEY=
# Legacy fallback for the economical stages; stage settings take precedence.
MODEL_NAME=gpt-6-luna
ANALYSIS_MODEL_NAME=gpt-6-luna
AGENT_MODEL_NAME=gpt-6-luna
SCENE_MODEL_NAME=gpt-6.1-sol
SCENE_REPAIR_MODEL_NAME=gpt-6-luna
# Reserved for the visual-review step; setting it does not enable extra calls.
REVIEW_MODEL_NAME=gpt-6-luna
ANALYSIS_REASONING_EFFORT=medium
REVIEW_REASONING_EFFORT=low
# One automatic photo/render review, plus at most one Luna visual correction.
VISUAL_REVIEW_ENABLED=true
REVIEW_MAX_OUTPUT_TOKENS=6144
# One optional Luna aesthetics assessment after reconstruction; measured cards
# remain available when its single call fails or the run budget is exhausted.
ROOM_ASSESSMENT_ENABLED=true
ASSESSMENT_MAX_OUTPUT_TOKENS=1536
OPTIMIZATION_MAX_CANDIDATES=3
OPTIMIZATION_MAX_MODEL_CALLS=6
OPTIMIZATION_MAX_OUTPUT_TOKENS=4096
SCENE_REPAIR_REASONING_EFFORT=medium
# Five-photo structured analysis may exceed 90 seconds. Each call remains bounded.
ANALYSIS_TIMEOUT_SECONDS=150
ANALYSIS_MAX_BODY_BYTES=4096
ANALYSIS_MAX_REQUEST_BYTES=45000000
ANALYSIS_MAX_OUTPUT_TOKENS=16384
# Scene output includes reasoning and the complete geometry JSON.
SCENE_MAX_OUTPUT_TOKENS=16384
# Use default to omit the reasoning option for another model.
SCENE_REASONING_EFFORT=medium
ANALYSIS_MAX_OUTPUT_BYTES=262144
# Total provider attempts per uploaded batch, including explicit client retries.
# 429/5xx may retry; completed inconsistent observations get one targeted repair.
# Refusals, truncation, malformed output, timeouts/connections do not retry.
ANALYSIS_MAX_PROVIDER_ATTEMPTS=2
ANALYSIS_MAX_CACHED_INPUTS=128
# Scene construction allows two calls total: one Sol initial request + one Luna
# repair/output-limit request. HTTP retries and dimension revisions share this cap.

# Agent decisions use AGENT_MODEL_NAME and ANALYSIS_ENABLED. Runs support
# clarification/resume; startup itself never makes a model request.
# Total provider requests include decisions, analysis, scene generation and repair.
AGENT_MAX_STEPS=16
# Reconstruction phase transitions and focused questions use state directly.
# Set false only to exercise the optional model-selected tool loop.
AGENT_DETERMINISTIC_ROUTING=true
SCENE_COMPACT_CONTEXT=true
# A target, not a cap: unique photo evidence can require more views.
SCENE_PHOTO_TARGET=3
# No dynamic room cache writes without deliberate reusable breakpoints.
MODEL_PROMPT_CACHE_MODE=explicit
AGENT_MAX_MODEL_CALLS=20
AGENT_MAX_TOOL_CALLS=24
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_MAX_REQUEST_BYTES=524288
AGENT_REASONING_EFFORT=low

# The local catalog process starts only when an agent catalog tool is called.
MCP_FURNITURE_TRANSPORT=stdio
MCP_FURNITURE_TIMEOUT_SECONDS=8
MCP_FURNITURE_MAX_RESPONSE_BYTES=65536

# Accounts: PostgreSQL connection and a private random key (at least 32 bytes).
# Apply schema changes explicitly with: uv run alembic upgrade head
# Missing account configuration keeps guest creation available.
# Durable private normalized photos; never use the temporary upload directory.
PROJECT_STORAGE_DIR=.local/project-images
DATABASE_URL=
TEST_DATABASE_URL=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_ATTEMPTS_PER_MINUTE=10

# Future integrations and budgets: placeholders, not required or enforced yet.
STORAGE_BUCKET=
STORAGE_ENDPOINT=
GENERATION_TIME_LIMIT_SECONDS=
MAX_GENERATION_COST_USD=
# AI allowances: omitted = off in development/test, on in production.
# Explicitly set false for unrestricted local testing; true to exercise quotas.
# Enforcement requires DATABASE_URL, JWT_SECRET_KEY and `alembic upgrade head`.
# GENERATION_QUOTA_ENABLED=false
AI_SESSIONS_PER_DAY=3
AI_ACTIONS_PER_SESSION=3
AI_GUEST_SESSIONS_PER_IP_PER_DAY=12
